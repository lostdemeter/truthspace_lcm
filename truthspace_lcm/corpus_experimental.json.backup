    {
      "text": "Areas of Research Philosophical Logic Philosophical logic investigates foundational questions about the nature and status of logic itself, distinct from its formal applications",
      "source": "Grokipedia-Logic",
      "agent": "logic"
    },
    {
      "text": "Areas of Research Philosophical Logic Philosophical logic investigates foundational questions about the nature and status of logic itself, distinct from its formal applications",
      "source": "Grokipedia-Logic",
      "agent": "logic"
    },
    {
      "text": "Areas of Research Philosophical Logic Philosophical logic investigates foundational questions about the nature and status of logic itself, distinct from its formal applications",
      "source": "Grokipedia-Logic",
      "agent": "logic"
    },
    {
      "text": "Areas of Research Philosophical Logic Philosophical logic investigates foundational questions about the nature and status of logic itself, distinct from its formal applications",
      "source": "Grokipedia-Logic",
      "agent": "logic"
    },
    {
      "text": "In this perspective, logical principles are not mere descriptions of psychological processes but imperatives for avoiding error in judgment",
      "source": "Grokipedia-Logic",
