    },
    {
      "text": "It carries an electric charge of \u22121 e, a rest mass of 938",
      "source": "Grokipedia-Proton",
      "agent": "carries"
    },
    {
      "text": "It carries an electric charge of \u22121 e, a rest mass of 938",
      "source": "Grokipedia-Proton",
      "agent": "carries"
    },
    {
      "text": "It carries an electric charge of \u22121 e, a rest mass of 938",
      "source": "Grokipedia-Proton",
      "agent": "carries"
    },
    {
      "text": "272 MeV/c\u00b2 identical to that of the proton, and has spin 1/2",
      "source": "Grokipedia-Proton",
      "agent": "272"
    },
    {
      "text": "272 MeV/c\u00b2 identical to that of the proton, and has spin 1/2",
      "source": "Grokipedia-Proton",
